<?xml version="1.0" encoding="utf-8"?>
<!--
    Fremont Wellness Watch Face - Luxury Instrument Edition.

    Curated layout for Robert's workday at the Fremont Academy Wellness Center.
    Built with Watch Face Format (WFF v2) for Galaxy Watch 7 / Wear OS 5.

    Visual Hierarchy (450x450 canvas):
        16 -  99   High-DPI Fremont Crest
       103 - 127   Gold letterspaced Date
       128 - 224   Bold Digital Time (Light in Ambient for OLED protection)
       236 - 290   Cockpit-Grade School Period Pod (Slot 1)
       302 - 388   Three Instrument Sub-Dial Complications (Slots 2, 3, 4)
       Outer Rim   Integrated Bezel Ring & Battery Gauge at 6 o'clock

    themeColor slots:
        .0 surface   sub-dial plates and capsule background
        .1 accent    Aztec gold date, active gauge arcs, countdown timers
        .2 primary   bold time and primary metrics (crisp white)
        .3 muted     icons and secondary labels
        .4 hairline  bezel ring and inactive gauge tracks
-->
<WatchFace width="450" height="450" clipShape="CIRCLE">
    <Metadata key="CLOCK_TYPE" value="DIGITAL"/>
    <Metadata key="PREVIEW_TIME" value="10:08:32"/>

    <UserConfigurations>
        <ColorConfiguration
            id="themeColor"
            defaultValue="0"
            displayName="config_theme_label"
            screenReaderText="config_theme_label">
            <ColorOption
                id="0"
                displayName="theme_fremont_green"
                colors="#0E3F27 #FFC72C #FFFFFF #8DAF9E #1A4D35" />
            <ColorOption
                id="1"
                displayName="theme_tactical"
                colors="#1C2422 #F59E0B #F8FAFC #94A3B8 #334155" />
            <ColorOption
                id="2"
                displayName="theme_midnight"
                colors="#0D2E2B #2DD4BF #F0FDFA #5EEAD4 #134E4A" />
        </ColorConfiguration>
    </UserConfigurations>

    <Scene backgroundColor="#ff000000">

        <!-- ================================================================= -->
        <!-- Dial Background: Soft luxury vignette for OLED depth               -->
        <!-- ================================================================= -->
        <PartDraw x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="0"/>
            <Ellipse x="0" y="0" width="450" height="450">
                <Fill color="#FF000000">
                    <RadialGradient
                        centerX="225" centerY="130" radius="280"
                        colors="#FF132219 #FF09130E #FF000000"
                        positions="0.0 0.50 1.0" />
                </Fill>
            </Ellipse>
        </PartDraw>

        <!-- Outer Bezel Ring -->
        <PartDraw x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="0"/>
            <Ellipse x="10" y="10" width="430" height="430">
                <Stroke thickness="1.5" color="[CONFIGURATION.themeColor.4]"/>
            </Ellipse>
        </PartDraw>

        <!-- ================================================================= -->
        <!-- Watch Battery: Integrated Bezel Gauge at 6 o'clock                -->
        <!-- 145 deg (Empty) to 215 deg (Full); 0 deg is 12 o'clock            -->
        <!-- ================================================================= -->
        <PartDraw x="0" y="0" width="450" height="450" alpha="90">
            <Variant mode="AMBIENT" target="alpha" value="0"/>
            <Arc centerX="225" centerY="225" width="430" height="430"
                 startAngle="145" endAngle="215">
                <Stroke thickness="4.5" color="[CONFIGURATION.themeColor.4]" cap="ROUND"/>
            </Arc>
        </PartDraw>
        <PartDraw x="0" y="0" width="450" height="450" alpha="255">
            <Variant mode="AMBIENT" target="alpha" value="90"/>
            <Arc centerX="225" centerY="225" width="430" height="430"
                 startAngle="145" endAngle="215">
                <Stroke thickness="4.5" color="[CONFIGURATION.themeColor.1]" cap="ROUND"/>
                <Transform target="endAngle"
                           value="145 + (clamp([BATTERY_PERCENT], 0, 100) / 100) * 70"/>
            </Arc>
        </PartDraw>

        <!-- ================================================================= -->
        <!-- School Crest: Sharp High-DPI Vector Emblem                        -->
        <!-- ================================================================= -->
        <PartImage x="175" y="16" width="100" height="83">
            <Variant mode="AMBIENT" target="alpha" value="90"/>
            <Image resource="@drawable/school_logo"/>
        </PartImage>

        <!-- Date Line: Letterspaced Aztec Gold -->
        <PartText x="0" y="103" width="450" height="24">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="16" weight="BOLD"
                      letterSpacing="0.14" color="[CONFIGURATION.themeColor.1]">
                    <Template>%s · %s %s
                        <Parameter expression="[DAY_OF_WEEK_S]"/>
                        <Parameter expression="[MONTH_S]"/>
                        <Parameter expression="[DAY]"/>
                    </Template>
                </Font>
            </Text>
        </PartText>

        <!-- ================================================================= -->
        <!-- Time Display: Bold in Active, Light in Ambient for Burn-in Safety  -->
        <!-- ================================================================= -->
        <DigitalClock x="0" y="128" width="450" height="98">
            <TimeText format="h:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER"
                      x="0" y="0" width="450" height="98">
                <Variant mode="AMBIENT" target="alpha" value="0"/>
                <Font family="SYNC_TO_DEVICE" size="86" weight="BOLD"
                      color="[CONFIGURATION.themeColor.2]"/>
            </TimeText>
            <TimeText format="h:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER"
                      x="0" y="0" width="450" height="98" alpha="0">
                <Variant mode="AMBIENT" target="alpha" value="255"/>
                <Font family="SYNC_TO_DEVICE" size="86" weight="LIGHT"
                      color="[CONFIGURATION.themeColor.2]"/>
            </TimeText>
        </DigitalClock>

        <!-- ================================================================= -->
        <!-- SLOT 1: Cockpit-Grade School Bell Period Pod                      -->
        <!-- Displays period name, class description, and countdown timer       -->
        <!-- ================================================================= -->
        <ComplicationSlot
            slotId="1"
            displayName="slot_school_schedule"
            supportedTypes="RANGED_VALUE SHORT_TEXT LONG_TEXT GOAL_PROGRESS EMPTY"
            x="75"
            y="236"
            width="300"
            height="54">
            <DefaultProviderPolicy
                primaryProvider="com.shieldrj.schoolperiod/com.shieldrj.schoolperiod.complication.PeriodComplicationService"
                primaryProviderType="RANGED_VALUE"
                secondaryProvider="com.shieldrj.schoolperiod.debug/com.shieldrj.schoolperiod.complication.PeriodComplicationService"
                secondaryProviderType="RANGED_VALUE"
                defaultSystemProvider="NEXT_EVENT"
                defaultSystemProviderType="SHORT_TEXT"/>
            <BoundingBox x="0" y="0" width="300" height="54" outlinePadding="2.0"/>

            <Complication type="RANGED_VALUE">
                <!-- Pod Background Plate -->
                <PartDraw x="0" y="0" width="300" height="54">
                    <RoundRectangle x="0" y="0" width="300" height="54"
                                    cornerRadiusX="27" cornerRadiusY="27">
                        <Fill color="[CONFIGURATION.themeColor.0]"/>
                    </RoundRectangle>
                </PartDraw>
                <!-- Hairline Gold Border -->
                <PartDraw x="0" y="0" width="300" height="54" alpha="90">
                    <RoundRectangle x="0" y="0" width="300" height="54"
                                    cornerRadiusX="27" cornerRadiusY="27">
                        <Stroke thickness="1.5" color="[CONFIGURATION.themeColor.1]"/>
                    </RoundRectangle>
                </PartDraw>
                <!-- Integrated Progress Arc along bottom curve -->
                <PartDraw x="0" y="0" width="300" height="54">
                    <Arc centerX="150" centerY="2038" width="4000" height="4000"
                         startAngle="-3.44" endAngle="3.44">
                        <Stroke thickness="3.5" color="[CONFIGURATION.themeColor.4]" cap="ROUND"/>
                    </Arc>
                    <Arc centerX="150" centerY="2038" width="4000" height="4000"
                         startAngle="-3.44" endAngle="3.44">
                        <Stroke thickness="3.5" color="[CONFIGURATION.themeColor.1]" cap="ROUND"/>
                        <Transform target="endAngle"
                                   value="-3.44 + (((clamp([COMPLICATION.RANGED_VALUE_VALUE], [COMPLICATION.RANGED_VALUE_MIN], [COMPLICATION.RANGED_VALUE_MAX]) - [COMPLICATION.RANGED_VALUE_MIN]) / ([COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN])) * 6.88)"/>
                    </Arc>
                </PartDraw>
                <!-- Class / Period Name -->
                <PartText x="26" y="10" width="165" height="26">
                    <Text align="START" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="20" weight="BOLD"
                              color="[CONFIGURATION.themeColor.2]">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
                        </Font>
                    </Text>
                </PartText>
                <!-- Time Remaining Countdown -->
                <PartText x="180" y="10" width="94" height="26">
                    <Text align="END" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="20" weight="BOLD"
                              color="[CONFIGURATION.themeColor.1]">
                            <Template>%s<Parameter expression="[COMPLICATION.TITLE]"/></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>

            <Complication type="SHORT_TEXT">
                <PartDraw x="0" y="0" width="300" height="54">
                    <RoundRectangle x="0" y="0" width="300" height="54"
                                    cornerRadiusX="27" cornerRadiusY="27">
                        <Fill color="[CONFIGURATION.themeColor.0]"/>
                    </RoundRectangle>
                </PartDraw>
                <PartDraw x="0" y="0" width="300" height="54" alpha="90">
                    <RoundRectangle x="0" y="0" width="300" height="54"
                                    cornerRadiusX="27" cornerRadiusY="27">
                        <Stroke thickness="1.5" color="[CONFIGURATION.themeColor.1]"/>
                    </RoundRectangle>
                </PartDraw>
                <PartText x="26" y="14" width="165" height="26">
                    <Text align="START" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="20" weight="BOLD"
                              color="[CONFIGURATION.themeColor.2]">
                            <Template>%s<Parameter expression="[COMPLICATION.TITLE]"/></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="180" y="14" width="94" height="26">
                    <Text align="END" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="20" weight="BOLD"
                              color="[CONFIGURATION.themeColor.1]">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>

            <Complication type="GOAL_PROGRESS">
                <PartDraw x="0" y="0" width="300" height="54">
                    <RoundRectangle x="0" y="0" width="300" height="54"
                                    cornerRadiusX="27" cornerRadiusY="27">
                        <Fill color="[CONFIGURATION.themeColor.0]"/>
                    </RoundRectangle>
                </PartDraw>
                <PartDraw x="0" y="0" width="300" height="54" alpha="90">
                    <RoundRectangle x="0" y="0" width="300" height="54"
                                    cornerRadiusX="27" cornerRadiusY="27">
                        <Stroke thickness="1.5" color="[CONFIGURATION.themeColor.1]"/>
                    </RoundRectangle>
                </PartDraw>
                <PartDraw x="0" y="0" width="300" height="54">
                    <Arc centerX="150" centerY="2038" width="4000" height="4000"
                         startAngle="-3.44" endAngle="3.44">
                        <Stroke thickness="3.5" color="[CONFIGURATION.themeColor.4]" cap="ROUND"/>
                    </Arc>
                    <Arc centerX="150" centerY="2038" width="4000" height="4000"
                         startAngle="-3.44" endAngle="3.44">
                        <Stroke thickness="3.5" color="[CONFIGURATION.themeColor.1]" cap="ROUND"/>
                        <Transform target="endAngle"
                                   value="-3.44 + (clamp([COMPLICATION.GOAL_PROGRESS_VALUE], 0, [COMPLICATION.GOAL_PROGRESS_TARGET_VALUE]) / [COMPLICATION.GOAL_PROGRESS_TARGET_VALUE]) * 6.88"/>
                    </Arc>
                </PartDraw>
                <PartText x="26" y="10" width="165" height="26">
                    <Text align="START" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="20" weight="BOLD"
                              color="[CONFIGURATION.themeColor.2]">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="180" y="10" width="94" height="26">
                    <Text align="END" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="20" weight="BOLD"
                              color="[CONFIGURATION.themeColor.1]">
                            <Template>%s<Parameter expression="[COMPLICATION.TITLE]"/></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>

            <Complication type="LONG_TEXT">
                <PartDraw x="0" y="0" width="300" height="54">
                    <RoundRectangle x="0" y="0" width="300" height="54"
                                    cornerRadiusX="27" cornerRadiusY="27">
                        <Fill color="[CONFIGURATION.themeColor.0]"/>
                    </RoundRectangle>
                </PartDraw>
                <PartDraw x="0" y="0" width="300" height="54" alpha="90">
                    <RoundRectangle x="0" y="0" width="300" height="54"
                                    cornerRadiusX="27" cornerRadiusY="27">
                        <Stroke thickness="1.5" color="[CONFIGURATION.themeColor.1]"/>
                    </RoundRectangle>
                </PartDraw>
                <PartText x="20" y="14" width="260" height="26">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="18" weight="BOLD"
                              color="[CONFIGURATION.themeColor.2]">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- ================================================================= -->
        <!-- SLOTS 2-4: Three Precision Instrument Sub-Dial Hubs               -->
        <!-- ================================================================= -->

        <!-- SLOT 2: Steps / Activity (Bottom Left) -->
        <ComplicationSlot
            slotId="2"
            displayName="slot_steps"
            supportedTypes="SHORT_TEXT RANGED_VALUE GOAL_PROGRESS SMALL_IMAGE MONOCHROMATIC_IMAGE EMPTY"
            x="78"
            y="302"
            width="86"
            height="86">
            <DefaultProviderPolicy
                defaultSystemProvider="STEP_COUNT"
                defaultSystemProviderType="SHORT_TEXT"/>
            <BoundingOval x="0" y="0" width="86" height="86" outlinePadding="2.0"/>

            <!-- Sub-Dial Background Halo Plate -->
            <PartDraw x="0" y="0" width="86" height="86" alpha="40">
                <Variant mode="AMBIENT" target="alpha" value="0"/>
                <RoundRectangle x="0" y="0" width="86" height="86"
                                cornerRadiusX="43" cornerRadiusY="43">
                    <Fill color="[CONFIGURATION.themeColor.0]"/>
                </RoundRectangle>
            </PartDraw>
            <PartDraw x="0" y="0" width="86" height="86" alpha="50">
                <Variant mode="AMBIENT" target="alpha" value="0"/>
                <RoundRectangle x="0" y="0" width="86" height="86"
                                cornerRadiusX="43" cornerRadiusY="43">
                    <Stroke thickness="1.0" color="[CONFIGURATION.themeColor.4]"/>
                </RoundRectangle>
            </PartDraw>

            <Complication type="SHORT_TEXT">
                <Condition>
                    <Expressions>
                        <Expression name="hasIcon"><![CDATA[[COMPLICATION.MONOCHROMATIC_IMAGE] != null]]></Expression>
                    </Expressions>
                    <Compare expression="hasIcon">
                        <PartImage x="32" y="16" width="22" height="22"
                                   tintColor="[CONFIGURATION.themeColor.3]">
                            <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]"/>
                        </PartImage>
                        <PartText x="0" y="44" width="86" height="26">
                            <Text align="CENTER" ellipsis="TRUE">
                                <Font family="SYNC_TO_DEVICE" size="19" weight="BOLD"
                                      color="[CONFIGURATION.themeColor.2]">
                                    <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Compare>
                    <Default>
                        <PartText x="0" y="22" width="86" height="26">
                            <Text align="CENTER" ellipsis="TRUE">
                                <Font family="SYNC_TO_DEVICE" size="21" weight="BOLD"
                                      color="[CONFIGURATION.themeColor.2]">
                                    <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
                                </Font>
                            </Text>
                        </PartText>
                        <PartText x="0" y="48" width="86" height="18">
                            <Text align="CENTER" ellipsis="TRUE">
                                <Font family="SYNC_TO_DEVICE" size="12" weight="MEDIUM"
                                      color="[CONFIGURATION.themeColor.3]">
                                    <Template>%s<Parameter expression="[COMPLICATION.TITLE]"/></Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Default>
                </Condition>
            </Complication>

            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="86" height="86">
                    <Arc centerX="43" centerY="43" width="76" height="76"
                         startAngle="-135" endAngle="135">
                        <Stroke thickness="3.5" color="[CONFIGURATION.themeColor.4]" cap="ROUND"/>
                    </Arc>
                    <Arc centerX="43" centerY="43" width="76" height="76"
                         startAngle="-135" endAngle="135">
                        <Stroke thickness="3.5" color="[CONFIGURATION.themeColor.1]" cap="ROUND"/>
                        <Transform target="endAngle"
                                   value="-135 + (((clamp([COMPLICATION.RANGED_VALUE_VALUE], [COMPLICATION.RANGED_VALUE_MIN], [COMPLICATION.RANGED_VALUE_MAX]) - [COMPLICATION.RANGED_VALUE_MIN]) / ([COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN])) * 270)"/>
                    </Arc>
                </PartDraw>
                <PartText x="8" y="30" width="70" height="26">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="18" weight="BOLD"
                              color="[CONFIGURATION.themeColor.2]">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>

            <Complication type="GOAL_PROGRESS">
                <PartDraw x="0" y="0" width="86" height="86">
                    <Arc centerX="43" centerY="43" width="76" height="76"
                         startAngle="-135" endAngle="135">
                        <Stroke thickness="3.5" color="[CONFIGURATION.themeColor.4]" cap="ROUND"/>
                    </Arc>
                    <Arc centerX="43" centerY="43" width="76" height="76"
                         startAngle="-135" endAngle="135">
                        <Stroke thickness="3.5" color="[CONFIGURATION.themeColor.1]" cap="ROUND"/>
                        <Transform target="endAngle"
                                   value="-135 + (clamp([COMPLICATION.GOAL_PROGRESS_VALUE], 0, [COMPLICATION.GOAL_PROGRESS_TARGET_VALUE]) / [COMPLICATION.GOAL_PROGRESS_TARGET_VALUE]) * 270"/>
                    </Arc>
                </PartDraw>
                <PartText x="8" y="30" width="70" height="26">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="18" weight="BOLD"
                              color="[CONFIGURATION.themeColor.2]">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>

            <Complication type="MONOCHROMATIC_IMAGE">
                <PartImage x="27" y="27" width="32" height="32"
                           tintColor="[CONFIGURATION.themeColor.2]">
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]"/>
                </PartImage>
            </Complication>

            <Complication type="SMALL_IMAGE">
                <PartImage x="27" y="27" width="32" height="32">
                    <Image resource="[COMPLICATION.SMALL_IMAGE]"/>
                </PartImage>
            </Complication>
        </ComplicationSlot>

        <!-- SLOT 3: Heart Rate / Biometrics (Bottom Center) -->
        <ComplicationSlot
            slotId="3"
            displayName="slot_heart_rate"
            supportedTypes="SHORT_TEXT RANGED_VALUE GOAL_PROGRESS SMALL_IMAGE MONOCHROMATIC_IMAGE EMPTY"
            x="182"
            y="302"
            width="86"
            height="86">
            <DefaultProviderPolicy
                defaultSystemProvider="HEART_RATE"
                defaultSystemProviderType="SHORT_TEXT"/>
            <BoundingOval x="0" y="0" width="86" height="86" outlinePadding="2.0"/>

            <!-- Sub-Dial Background Halo Plate -->
            <PartDraw x="0" y="0" width="86" height="86" alpha="40">
                <Variant mode="AMBIENT" target="alpha" value="0"/>
                <RoundRectangle x="0" y="0" width="86" height="86"
                                cornerRadiusX="43" cornerRadiusY="43">
                    <Fill color="[CONFIGURATION.themeColor.0]"/>
                </RoundRectangle>
            </PartDraw>
            <PartDraw x="0" y="0" width="86" height="86" alpha="50">
                <Variant mode="AMBIENT" target="alpha" value="0"/>
                <RoundRectangle x="0" y="0" width="86" height="86"
                                cornerRadiusX="43" cornerRadiusY="43">
                    <Stroke thickness="1.0" color="[CONFIGURATION.themeColor.4]"/>
                </RoundRectangle>
            </PartDraw>

            <Complication type="SHORT_TEXT">
                <Condition>
                    <Expressions>
                        <Expression name="hasIcon"><![CDATA[[COMPLICATION.MONOCHROMATIC_IMAGE] != null]]></Expression>
                    </Expressions>
                    <Compare expression="hasIcon">
                        <PartImage x="32" y="16" width="22" height="22"
                                   tintColor="[CONFIGURATION.themeColor.3]">
                            <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]"/>
                        </PartImage>
                        <PartText x="0" y="44" width="86" height="26">
                            <Text align="CENTER" ellipsis="TRUE">
                                <Font family="SYNC_TO_DEVICE" size="19" weight="BOLD"
                                      color="[CONFIGURATION.themeColor.2]">
                                    <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Compare>
                    <Default>
                        <PartText x="0" y="22" width="86" height="26">
                            <Text align="CENTER" ellipsis="TRUE">
                                <Font family="SYNC_TO_DEVICE" size="21" weight="BOLD"
                                      color="[CONFIGURATION.themeColor.2]">
                                    <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
                                </Font>
                            </Text>
                        </PartText>
                        <PartText x="0" y="48" width="86" height="18">
                            <Text align="CENTER" ellipsis="TRUE">
                                <Font family="SYNC_TO_DEVICE" size="12" weight="MEDIUM"
                                      color="[CONFIGURATION.themeColor.3]">
                                    <Template>%s<Parameter expression="[COMPLICATION.TITLE]"/></Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Default>
                </Condition>
            </Complication>

            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="86" height="86">
                    <Arc centerX="43" centerY="43" width="76" height="76"
                         startAngle="-135" endAngle="135">
                        <Stroke thickness="3.5" color="[CONFIGURATION.themeColor.4]" cap="ROUND"/>
                    </Arc>
                    <Arc centerX="43" centerY="43" width="76" height="76"
                         startAngle="-135" endAngle="135">
                        <Stroke thickness="3.5" color="[CONFIGURATION.themeColor.1]" cap="ROUND"/>
                        <Transform target="endAngle"
                                   value="-135 + (((clamp([COMPLICATION.RANGED_VALUE_VALUE], [COMPLICATION.RANGED_VALUE_MIN], [COMPLICATION.RANGED_VALUE_MAX]) - [COMPLICATION.RANGED_VALUE_MIN]) / ([COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN])) * 270)"/>
                    </Arc>
                </PartDraw>
                <PartText x="8" y="30" width="70" height="26">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="18" weight="BOLD"
                              color="[CONFIGURATION.themeColor.2]">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>

            <Complication type="GOAL_PROGRESS">
                <PartDraw x="0" y="0" width="86" height="86">
                    <Arc centerX="43" centerY="43" width="76" height="76"
                         startAngle="-135" endAngle="135">
                        <Stroke thickness="3.5" color="[CONFIGURATION.themeColor.4]" cap="ROUND"/>
                    </Arc>
                    <Arc centerX="43" centerY="43" width="76" height="76"
                         startAngle="-135" endAngle="135">
                        <Stroke thickness="3.5" color="[CONFIGURATION.themeColor.1]" cap="ROUND"/>
                        <Transform target="endAngle"
                                   value="-135 + (clamp([COMPLICATION.GOAL_PROGRESS_VALUE], 0, [COMPLICATION.GOAL_PROGRESS_TARGET_VALUE]) / [COMPLICATION.GOAL_PROGRESS_TARGET_VALUE]) * 270"/>
                    </Arc>
                </PartDraw>
                <PartText x="8" y="30" width="70" height="26">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="18" weight="BOLD"
                              color="[CONFIGURATION.themeColor.2]">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>

            <Complication type="MONOCHROMATIC_IMAGE">
                <PartImage x="27" y="27" width="32" height="32"
