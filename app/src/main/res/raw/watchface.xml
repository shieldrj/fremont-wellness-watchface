<?xml version="1.0" encoding="utf-8"?>
<!--
    Fremont Crest.

    One vertical column, read top to bottom: the school crest, the date, the time,
    the current class period, then three small readouts. Nothing is boxed in and
    nothing overlaps, so an empty complication leaves clean space rather than an
    empty grey circle.

    The dial is black. Colour appears only where it carries meaning: the crest,
    the gold date line, the period capsule and the battery gauge on the rim.

    Vertical rhythm (450x450 canvas):
        20 - 104   crest
       108 - 132   date
       136 - 240   time
       252 - 302   period capsule
       312 - 386   three small complications
       rim         battery gauge, centred on 6 o'clock

    themeColor slots, in order:
        .0 surface   capsule fill
        .1 accent    date, gauges, period countdown
        .2 primary   time and complication values
        .3 muted     secondary labels and icons
        .4 hairline  rim ring and gauge tracks
-->
<WatchFace width="450" height="450" clipShape="CIRCLE">
    <Metadata key="CLOCK_TYPE" value="DIGITAL"/>
    <Metadata key="PREVIEW_TIME" value="10:08:32"/>

    <UserConfigurations>
        <ColorConfiguration
            id="themeColor"
            defaultValue="0"
            displayName="config_theme_label"
            screenReaderText="config_theme_label">
            <ColorOption
                id="0"
                displayName="theme_fremont_green"
                colors="#0E4D2D #FFC72C #FFF8E7 #7FA391 #1B3D2C" />
            <ColorOption
                id="1"
                displayName="theme_tactical"
                colors="#242C29 #E6A817 #EDEFEE #93A29B #333D39" />
            <ColorOption
                id="2"
                displayName="theme_midnight"
                colors="#0D2E2B #35C4A8 #E8F5F2 #82A8A2 #12433D" />
        </ColorConfiguration>
    </UserConfigurations>

    <Scene backgroundColor="#ff000000">

        <!-- ================================================================= -->
        <!-- Dial: a near-black vignette so the face has depth without lighting -->
        <!-- up pixels. Dropped entirely in ambient.                           -->
        <!-- ================================================================= -->
        <PartDraw x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="0"/>
            <Ellipse x="0" y="0" width="450" height="450">
                <Fill color="#FF000000">
                    <RadialGradient
                        centerX="225" centerY="140" radius="300"
                        colors="#FF141B17 #FF0A0E0C #FF000000"
                        positions="0.0 0.45 1.0" />
                </Fill>
            </Ellipse>
        </PartDraw>

        <!-- Rim ring. -->
        <PartDraw x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="0"/>
            <Ellipse x="10" y="10" width="430" height="430">
                <Stroke thickness="1.5" color="[CONFIGURATION.themeColor.4]"/>
            </Ellipse>
        </PartDraw>

        <!-- ================================================================= -->
        <!-- Watch battery, as a gauge sitting on the rim at 6 o'clock.         -->
        <!-- 145 degrees is empty and 215 is full; 0 degrees is 12 o'clock.     -->
        <!-- ================================================================= -->
        <PartDraw x="0" y="0" width="450" height="450" alpha="80">
            <Variant mode="AMBIENT" target="alpha" value="0"/>
            <Arc centerX="225" centerY="225" width="430" height="430"
                 startAngle="145" endAngle="215">
                <Stroke thickness="4" color="[CONFIGURATION.themeColor.3]" cap="ROUND"/>
            </Arc>
        </PartDraw>
        <PartDraw x="0" y="0" width="450" height="450" alpha="230">
            <Variant mode="AMBIENT" target="alpha" value="90"/>
            <Arc centerX="225" centerY="225" width="430" height="430"
                 startAngle="145" endAngle="215">
                <Stroke thickness="4" color="[CONFIGURATION.themeColor.1]" cap="ROUND"/>
                <Transform target="endAngle"
                           value="145 + (clamp([BATTERY_PERCENT], 0, 100) / 100) * 70"/>
            </Arc>
        </PartDraw>

        <!-- ================================================================= -->
        <!-- School crest. The one piece of full colour on the dial, so it is   -->
        <!-- what the eye lands on first. Dimmed, not hidden, in ambient.       -->
        <!-- ================================================================= -->
        <PartImage x="173" y="20" width="104" height="84">
            <Variant mode="AMBIENT" target="alpha" value="110"/>
            <Image resource="@drawable/school_logo"/>
        </PartImage>

        <!-- Date, in the accent colour and letterspaced so it reads as a label
             rather than as another line of data. -->
        <PartText x="0" y="108" width="450" height="26">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="17" weight="MEDIUM"
                      letterSpacing="0.12" color="[CONFIGURATION.themeColor.1]">
                    <Template>%s · %s %s
                        <Parameter expression="[DAY_OF_WEEK_S]"/>
                        <Parameter expression="[MONTH_S]"/>
                        <Parameter expression="[DAY]"/>
                    </Template>
                </Font>
            </Text>
        </PartText>

        <!-- ================================================================= -->
        <!-- Time. Bold when the screen is awake, light in ambient: thinner     -->
        <!-- strokes are the standard guard against OLED burn-in.               -->
        <!-- ================================================================= -->
        <DigitalClock x="0" y="136" width="450" height="104">
            <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER"
                      x="0" y="0" width="450" height="104">
                <Variant mode="AMBIENT" target="alpha" value="0"/>
                <Font family="SYNC_TO_DEVICE" size="88" weight="BOLD"
                      color="[CONFIGURATION.themeColor.2]"/>
            </TimeText>
            <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER"
                      x="0" y="0" width="450" height="104" alpha="0">
                <Variant mode="AMBIENT" target="alpha" value="255"/>
                <Font family="SYNC_TO_DEVICE" size="88" weight="LIGHT"
                      color="[CONFIGURATION.themeColor.2]"/>
            </TimeText>
        </DigitalClock>

        <!-- ================================================================= -->
        <!-- SLOT 1: the class period. A single wide capsule, because this is   -->
        <!-- the thing worth reading at a glance during a school day.           -->
        <!-- RANGED_VALUE is preferred: the period app reports the period name, -->
        <!-- the minutes left, and how far through the period we are.           -->
        <!-- ================================================================= -->
        <ComplicationSlot
            slotId="1"
            displayName="slot_school_schedule"
            supportedTypes="RANGED_VALUE SHORT_TEXT LONG_TEXT GOAL_PROGRESS EMPTY"
            x="79"
            y="252"
            width="292"
            height="50">
            <DefaultProviderPolicy
                primaryProvider="com.shieldrj.schoolperiod/com.shieldrj.schoolperiod.complication.PeriodComplicationService"
                primaryProviderType="RANGED_VALUE"
                secondaryProvider="com.shieldrj.schoolperiod.debug/com.shieldrj.schoolperiod.complication.PeriodComplicationService"
                secondaryProviderType="RANGED_VALUE"
                defaultSystemProvider="NEXT_EVENT"
                defaultSystemProviderType="SHORT_TEXT"/>
            <BoundingBox x="0" y="0" width="292" height="50" outlinePadding="2.0"/>

            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="292" height="50">
                    <RoundRectangle x="0" y="0" width="292" height="50"
                                    cornerRadiusX="25" cornerRadiusY="25">
                        <Fill color="[CONFIGURATION.themeColor.0]"/>
                    </RoundRectangle>
                </PartDraw>
                <PartDraw x="0" y="0" width="292" height="50" alpha="70">
                    <RoundRectangle x="0" y="0" width="292" height="50"
                                    cornerRadiusX="25" cornerRadiusY="25">
                        <Stroke thickness="1.5" color="[CONFIGURATION.themeColor.1]"/>
                    </RoundRectangle>
                </PartDraw>
                <!-- Progress through the period, as an arc tracing the bottom
                     of the capsule. -->
                <PartDraw x="0" y="0" width="292" height="50">
                    <Arc centerX="146" centerY="2038" width="4000" height="4000"
                         startAngle="-3.44" endAngle="3.44">
                        <Stroke thickness="3" color="[CONFIGURATION.themeColor.4]" cap="ROUND"/>
                    </Arc>
                    <Arc centerX="146" centerY="2038" width="4000" height="4000"
                         startAngle="-3.44" endAngle="3.44">
                        <Stroke thickness="3" color="[CONFIGURATION.themeColor.1]" cap="ROUND"/>
                        <Transform target="endAngle"
                                   value="-3.44 + (((clamp([COMPLICATION.RANGED_VALUE_VALUE], [COMPLICATION.RANGED_VALUE_MIN], [COMPLICATION.RANGED_VALUE_MAX]) - [COMPLICATION.RANGED_VALUE_MIN]) / ([COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN])) * 6.88)"/>
                    </Arc>
                </PartDraw>
                <PartText x="26" y="8" width="170" height="24">
                    <Text align="START" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="20" weight="BOLD"
                              color="[CONFIGURATION.themeColor.2]">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="176" y="8" width="90" height="24">
                    <Text align="END" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="20" weight="BOLD"
                              color="[CONFIGURATION.themeColor.1]">
                            <Template>%s<Parameter expression="[COMPLICATION.TITLE]"/></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>

            <Complication type="SHORT_TEXT">
                <PartDraw x="0" y="0" width="292" height="50">
                    <RoundRectangle x="0" y="0" width="292" height="50"
                                    cornerRadiusX="25" cornerRadiusY="25">
                        <Fill color="[CONFIGURATION.themeColor.0]"/>
                    </RoundRectangle>
                </PartDraw>
                <PartDraw x="0" y="0" width="292" height="50" alpha="70">
                    <RoundRectangle x="0" y="0" width="292" height="50"
                                    cornerRadiusX="25" cornerRadiusY="25">
                        <Stroke thickness="1.5" color="[CONFIGURATION.themeColor.1]"/>
                    </RoundRectangle>
                </PartDraw>
                <PartText x="26" y="13" width="170" height="24">
                    <Text align="START" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="20" weight="BOLD"
                              color="[CONFIGURATION.themeColor.2]">
                            <Template>%s<Parameter expression="[COMPLICATION.TITLE]"/></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="176" y="13" width="90" height="24">
                    <Text align="END" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="20" weight="BOLD"
                              color="[CONFIGURATION.themeColor.1]">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>

            <Complication type="GOAL_PROGRESS">
                <PartDraw x="0" y="0" width="292" height="50">
                    <RoundRectangle x="0" y="0" width="292" height="50"
                                    cornerRadiusX="25" cornerRadiusY="25">
                        <Fill color="[CONFIGURATION.themeColor.0]"/>
                    </RoundRectangle>
                </PartDraw>
                <PartDraw x="0" y="0" width="292" height="50" alpha="70">
                    <RoundRectangle x="0" y="0" width="292" height="50"
                                    cornerRadiusX="25" cornerRadiusY="25">
                        <Stroke thickness="1.5" color="[CONFIGURATION.themeColor.1]"/>
                    </RoundRectangle>
                </PartDraw>
                <PartDraw x="0" y="0" width="292" height="50">
                    <Arc centerX="146" centerY="2038" width="4000" height="4000"
                         startAngle="-3.44" endAngle="3.44">
                        <Stroke thickness="3" color="[CONFIGURATION.themeColor.4]" cap="ROUND"/>
                    </Arc>
                    <Arc centerX="146" centerY="2038" width="4000" height="4000"
                         startAngle="-3.44" endAngle="3.44">
                        <Stroke thickness="3" color="[CONFIGURATION.themeColor.1]" cap="ROUND"/>
                        <Transform target="endAngle"
                                   value="-3.44 + (clamp([COMPLICATION.GOAL_PROGRESS_VALUE], 0, [COMPLICATION.GOAL_PROGRESS_TARGET_VALUE]) / [COMPLICATION.GOAL_PROGRESS_TARGET_VALUE]) * 6.88"/>
                    </Arc>
                </PartDraw>
                <PartText x="26" y="8" width="170" height="24">
                    <Text align="START" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="20" weight="BOLD"
                              color="[CONFIGURATION.themeColor.2]">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="176" y="8" width="90" height="24">
                    <Text align="END" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="20" weight="BOLD"
                              color="[CONFIGURATION.themeColor.1]">
                            <Template>%s<Parameter expression="[COMPLICATION.TITLE]"/></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>

            <Complication type="LONG_TEXT">
                <PartDraw x="0" y="0" width="292" height="50">
                    <RoundRectangle x="0" y="0" width="292" height="50"
                                    cornerRadiusX="25" cornerRadiusY="25">
                        <Fill color="[CONFIGURATION.themeColor.0]"/>
                    </RoundRectangle>
                </PartDraw>
                <PartDraw x="0" y="0" width="292" height="50" alpha="70">
                    <RoundRectangle x="0" y="0" width="292" height="50"
                                    cornerRadiusX="25" cornerRadiusY="25">
                        <Stroke thickness="1.5" color="[CONFIGURATION.themeColor.1]"/>
                    </RoundRectangle>
                </PartDraw>
                <PartText x="22" y="13" width="248" height="24">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="18" weight="BOLD"
                              color="[CONFIGURATION.themeColor.2]">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- ================================================================= -->
        <!-- SLOTS 2-4: three small readouts across the bottom. No frame and no -->
        <!-- filled circle: an icon over a value, or a ring when the source     -->
        <!-- reports a range. An empty slot draws nothing at all.               -->
        <!-- ================================================================= -->
        <ComplicationSlot
            slotId="2"
            displayName="slot_steps"
            supportedTypes="SHORT_TEXT RANGED_VALUE GOAL_PROGRESS SMALL_IMAGE MONOCHROMATIC_IMAGE EMPTY"
            x="92"
            y="312"
            width="74"
            height="74">
            <DefaultProviderPolicy
                defaultSystemProvider="STEP_COUNT"
                defaultSystemProviderType="SHORT_TEXT"/>
            <BoundingOval x="0" y="0" width="74" height="74" outlinePadding="2.0"/>

            <Complication type="SHORT_TEXT">
                <Condition>
                    <Expressions>
                        <Expression name="hasIcon"><![CDATA[[COMPLICATION.MONOCHROMATIC_IMAGE] != null]]></Expression>
                    </Expressions>
                    <Compare expression="hasIcon">
                        <PartImage x="26" y="12" width="22" height="22"
                                   tintColor="[CONFIGURATION.themeColor.3]">
                            <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]"/>
                        </PartImage>
                        <PartText x="0" y="38" width="74" height="26">
                            <Text align="CENTER" ellipsis="TRUE">
                                <Font family="SYNC_TO_DEVICE" size="19" weight="BOLD"
                                      color="[CONFIGURATION.themeColor.2]">
                                    <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Compare>
                    <Default>
                        <PartText x="0" y="18" width="74" height="26">
                            <Text align="CENTER" ellipsis="TRUE">
                                <Font family="SYNC_TO_DEVICE" size="21" weight="BOLD"
                                      color="[CONFIGURATION.themeColor.2]">
                                    <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
                                </Font>
                            </Text>
                        </PartText>
                        <PartText x="0" y="43" width="74" height="18">
                            <Text align="CENTER" ellipsis="TRUE">
                                <Font family="SYNC_TO_DEVICE" size="12" weight="MEDIUM"
                                      color="[CONFIGURATION.themeColor.3]">
                                    <Template>%s<Parameter expression="[COMPLICATION.TITLE]"/></Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Default>
                </Condition>
            </Complication>

            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="74" height="74">
                    <Arc centerX="37" centerY="37" width="68" height="68"
                         startAngle="-140" endAngle="140">
                        <Stroke thickness="3" color="[CONFIGURATION.themeColor.4]" cap="ROUND"/>
                    </Arc>
                    <Arc centerX="37" centerY="37" width="68" height="68"
                         startAngle="-140" endAngle="140">
                        <Stroke thickness="3" color="[CONFIGURATION.themeColor.1]" cap="ROUND"/>
                        <Transform target="endAngle"
                                   value="-140 + (((clamp([COMPLICATION.RANGED_VALUE_VALUE], [COMPLICATION.RANGED_VALUE_MIN], [COMPLICATION.RANGED_VALUE_MAX]) - [COMPLICATION.RANGED_VALUE_MIN]) / ([COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN])) * 280)"/>
                    </Arc>
                </PartDraw>
                <PartText x="0" y="24" width="74" height="26">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="19" weight="BOLD"
                              color="[CONFIGURATION.themeColor.2]">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>

            <Complication type="GOAL_PROGRESS">
                <PartDraw x="0" y="0" width="74" height="74">
                    <Arc centerX="37" centerY="37" width="68" height="68"
                         startAngle="-140" endAngle="140">
                        <Stroke thickness="3" color="[CONFIGURATION.themeColor.4]" cap="ROUND"/>
                    </Arc>
                    <Arc centerX="37" centerY="37" width="68" height="68"
                         startAngle="-140" endAngle="140">
                        <Stroke thickness="3" color="[CONFIGURATION.themeColor.1]" cap="ROUND"/>
                        <Transform target="endAngle"
                                   value="-140 + (clamp([COMPLICATION.GOAL_PROGRESS_VALUE], 0, [COMPLICATION.GOAL_PROGRESS_TARGET_VALUE]) / [COMPLICATION.GOAL_PROGRESS_TARGET_VALUE]) * 280"/>
                    </Arc>
                </PartDraw>
                <PartText x="0" y="24" width="74" height="26">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="19" weight="BOLD"
                              color="[CONFIGURATION.themeColor.2]">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>

            <Complication type="MONOCHROMATIC_IMAGE">
                <PartImage x="21" y="21" width="32" height="32"
                           tintColor="[CONFIGURATION.themeColor.2]">
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]"/>
                </PartImage>
            </Complication>

            <Complication type="SMALL_IMAGE">
                <PartImage x="21" y="21" width="32" height="32">
                    <Image resource="[COMPLICATION.SMALL_IMAGE]"/>
                </PartImage>
            </Complication>
        </ComplicationSlot>

        <ComplicationSlot
            slotId="3"
            displayName="slot_heart_rate"
            supportedTypes="SHORT_TEXT RANGED_VALUE GOAL_PROGRESS SMALL_IMAGE MONOCHROMATIC_IMAGE EMPTY"
            x="188"
            y="312"
            width="74"
            height="74">
            <DefaultProviderPolicy
                defaultSystemProvider="HEART_RATE"
                defaultSystemProviderType="SHORT_TEXT"/>
            <BoundingOval x="0" y="0" width="74" height="74" outlinePadding="2.0"/>

            <Complication type="SHORT_TEXT">
                <Condition>
                    <Expressions>
                        <Expression name="hasIcon"><![CDATA[[COMPLICATION.MONOCHROMATIC_IMAGE] != null]]></Expression>
                    </Expressions>
                    <Compare expression="hasIcon">
                        <PartImage x="26" y="12" width="22" height="22"
                                   tintColor="[CONFIGURATION.themeColor.3]">
                            <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]"/>
                        </PartImage>
                        <PartText x="0" y="38" width="74" height="26">
                            <Text align="CENTER" ellipsis="TRUE">
                                <Font family="SYNC_TO_DEVICE" size="19" weight="BOLD"
                                      color="[CONFIGURATION.themeColor.2]">
                                    <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Compare>
                    <Default>
                        <PartText x="0" y="18" width="74" height="26">
                            <Text align="CENTER" ellipsis="TRUE">
                                <Font family="SYNC_TO_DEVICE" size="21" weight="BOLD"
                                      color="[CONFIGURATION.themeColor.2]">
                                    <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
                                </Font>
                            </Text>
                        </PartText>
                        <PartText x="0" y="43" width="74" height="18">
                            <Text align="CENTER" ellipsis="TRUE">
                                <Font family="SYNC_TO_DEVICE" size="12" weight="MEDIUM"
                                      color="[CONFIGURATION.themeColor.3]">
                                    <Template>%s<Parameter expression="[COMPLICATION.TITLE]"/></Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Default>
                </Condition>
            </Complication>

            <Complication type="RANGED_VALUE">
                <PartDraw x="0" y="0" width="74" height="74">
                    <Arc centerX="37" centerY="37" width="68" height="68"
                         startAngle="-140" endAngle="140">
                        <Stroke thickness="3" color="[CONFIGURATION.themeColor.4]" cap="ROUND"/>
                    </Arc>
                    <Arc centerX="37" centerY="37" width="68" height="68"
                         startAngle="-140" endAngle="140">
                        <Stroke thickness="3" color="[CONFIGURATION.themeColor.1]" cap="ROUND"/>
                        <Transform target="endAngle"
                                   value="-140 + (((clamp([COMPLICATION.RANGED_VALUE_VALUE], [COMPLICATION.RANGED_VALUE_MIN], [COMPLICATION.RANGED_VALUE_MAX]) - [COMPLICATION.RANGED_VALUE_MIN]) / ([COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN])) * 280)"/>
                    </Arc>
                </PartDraw>
                <PartText x="0" y="24" width="74" height="26">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="19" weight="BOLD"
                              color="[CONFIGURATION.themeColor.2]">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>

            <Complication type="GOAL_PROGRESS">
                <PartDraw x="0" y="0" width="74" height="74">
                    <Arc centerX="37" centerY="37" width="68" height="68"
                         startAngle="-140" endAngle="140">
                        <Stroke thickness="3" color="[CONFIGURATION.themeColor.4]" cap="ROUND"/>
                    </Arc>
                    <Arc centerX="37" centerY="37" width="68" height="68"
                         startAngle="-140" endAngle="140">
                        <Stroke thickness="3" color="[CONFIGURATION.themeColor.1]" cap="ROUND"/>
                        <Transform target="endAngle"
                                   value="-140 + (clamp([COMPLICATION.GOAL_PROGRESS_VALUE], 0, [COMPLICATION.GOAL_PROGRESS_TARGET_VALUE]) / [COMPLICATION.GOAL_PROGRESS_TARGET_VALUE]) * 280"/>
                    </Arc>
                </PartDraw>
                <PartText x="0" y="24" width="74" height="26">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="19" weight="BOLD"
                              color="[CONFIGURATION.themeColor.2]">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>

            <Complication type="MONOCHROMATIC_IMAGE">
                <PartImage x="21" y="21" width="32" height="32"
                           tintColor="[CONFIGURATION.themeColor.2]">
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]"/>
                </PartImage>
            </Complication>

            <Complication type="SMALL_IMAGE">
                <PartImage x="21" y="21" width="32" height="32">
                    <Image resource="[COMPLICATION.SMALL_IMAGE]"/>
                </PartImage>
            </Complication>
        </ComplicationSlot>

        <ComplicationSlot
            slotId="4"
            displayName="slot_weather"
            supportedTypes="SHORT_TEXT RANGED_VALUE GOAL_PROGRESS SMALL_IMAGE MONOCHROMATIC_IMAGE EMPTY"
            x="284"
            y="312"
            width="74"
            height="74">
            <DefaultProviderPolicy
                defaultSystemProvider="SUNRISE_SUNSET"
                defaultSystemProviderType="SHORT_TEXT"/>
            <BoundingOval x="0" y="0" width="74" height="74" outlinePadding="2.0"/>

            <Complication type="SHORT_TEXT">
                <Condition>
                    <Expressions>
                        <Expression name="hasIcon"><![CDATA[[COMPLICATION.MONOCHROMATIC_IMAGE] != null]]></Expression>
                    </Expressions>
                    <Compare expression="hasIcon">
                        <PartImage x="26" y="12" width="22" height="22"
                                   tintColor="[CONFIGURATION.themeColor.3]">
                            <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]"/>
                        </PartImage>
                        <PartText x="0" y="38" width="74" height="26">
