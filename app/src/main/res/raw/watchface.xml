<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL"/>
    <Metadata key="PREVIEW_TIME" value="10:08:32"/>

    <UserConfigurations>
        <ColorConfiguration
            id="themeColor"
            defaultValue="0"
            displayName="config_theme_label"
            screenReaderText="config_theme_label">
            <ColorOption
                id="0"
                displayName="theme_fremont_green"
                colors="#0E4D2D #FFC72C #FFF8E7 #186B43" />
            <ColorOption
                id="1"
                displayName="theme_tactical"
                colors="#1C2321 #E6A817 #E0E0E0 #3A4743" />
            <ColorOption
                id="2"
                displayName="theme_midnight"
                colors="#0D2E2B #288B77 #E8F5F2 #175449" />
        </ColorConfiguration>
    </UserConfigurations>

    <Scene backgroundColor="#ff000000">

        <!-- Outer Accent Bezel Ring -->
        <PartDraw x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="0"/>
            <Ellipse x="12" y="12" width="426" height="426">
                <Stroke thickness="4" color="[CONFIGURATION.themeColor.0]"/>
            </Ellipse>
            <Line startX="225" startY="12" endX="225" endY="24">
                <Stroke thickness="3" color="[CONFIGURATION.themeColor.1]"/>
            </Line>
            <Line startX="438" startY="225" endX="426" endY="225">
                <Stroke thickness="3" color="[CONFIGURATION.themeColor.1]"/>
            </Line>
            <Line startX="225" startY="438" endX="225" endY="426">
                <Stroke thickness="3" color="[CONFIGURATION.themeColor.1]"/>
            </Line>
            <Line startX="12" startY="225" endX="24" endY="225">
                <Stroke thickness="3" color="[CONFIGURATION.themeColor.1]"/>
            </Line>
        </PartDraw>

        <!-- Center Fremont School Shield Emblem -->
        <PartImage x="195" y="125" width="60" height="60">
            <Variant mode="AMBIENT" target="alpha" value="70"/>
            <Image resource="school_logo"/>
        </PartImage>

        <!-- Center Digital Clock -->
        <DigitalClock x="0" y="0" width="450" height="450">
            <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER" x="0" y="186" width="450" height="64">
                <Font family="SYNC_TO_DEVICE" size="58" weight="BOLD" color="#ffffffff"/>
            </TimeText>
        </DigitalClock>

        <!-- Date & Day of Week -->
        <PartText x="0" y="258" width="450" height="28">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="18" weight="MEDIUM" color="[CONFIGURATION.themeColor.1]">
                    <Template>%s, %s %s
                        <Parameter expression="[DAY_OF_WEEK_SHORT]"/>
                        <Parameter expression="[MONTH_SHORT]"/>
                        <Parameter expression="[DAY]"/>
                    </Template>
                </Font>
            </Text>
        </PartText>

        <!-- ================================================================= -->
        <!-- COMPLICATION SLOT 1: School Bell Period & Countdown (Top Center)  -->
        <!-- ================================================================= -->
        <ComplicationSlot
            slotId="1"
            displayName="slot_school_schedule"
            supportedTypes="SHORT_TEXT RANGED_VALUE LONG_TEXT SMALL_IMAGE MONOCHROMATIC_IMAGE EMPTY"
            x="125"
            y="32"
            width="200"
            height="70">
            <BoundingBox x="0" y="0" width="200" height="70" outlinePadding="2.0"/>
            <Complication type="SHORT_TEXT">
                <PartDraw x="0" y="0" width="200" height="70">
                    <RoundRectangle x="0" y="0" width="200" height="70" cornerRadiusX="16" cornerRadiusY="16">
                        <Fill color="#122A1E"/>
                        <Stroke thickness="1.5" color="[CONFIGURATION.themeColor.3]"/>
                    </RoundRectangle>
                </PartDraw>
                <PartText x="0" y="8" width="200" height="30">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="22" weight="BOLD" color="#ffffffff">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="0" y="38" width="200" height="22">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="14" weight="NORMAL" color="[CONFIGURATION.themeColor.1]">
                            <Template>%s<Parameter expression="[COMPLICATION.TITLE]"/></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="LONG_TEXT">
                <PartText x="10" y="10" width="180" height="50">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="16" weight="MEDIUM" color="#ffffffff">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="RANGED_VALUE">
                <PartText x="0" y="18" width="200" height="34">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="20" weight="BOLD" color="#ffffffff">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- ================================================================= -->
        <!-- COMPLICATION SLOT 2: Heart Rate / Wellness (Top Right)            -->
        <!-- ================================================================= -->
        <ComplicationSlot
            slotId="2"
            displayName="slot_heart_rate"
            supportedTypes="SHORT_TEXT RANGED_VALUE SMALL_IMAGE MONOCHROMATIC_IMAGE EMPTY"
            x="328"
            y="80"
            width="80"
            height="80">
            <BoundingOval x="0" y="0" width="80" height="80" outlinePadding="2.0"/>
            <Complication type="SHORT_TEXT">
                <PartDraw x="0" y="0" width="80" height="80">
                    <Ellipse x="0" y="0" width="80" height="80">
                        <Fill color="#1C2321"/>
                        <Stroke thickness="1.5" color="[CONFIGURATION.themeColor.1]"/>
                    </Ellipse>
                </PartDraw>
                <PartImage x="26" y="10" width="28" height="28">
