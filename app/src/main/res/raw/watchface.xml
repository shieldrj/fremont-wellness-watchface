<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450" clipShape="CIRCLE">
    <Metadata key="CLOCK_TYPE" value="DIGITAL"/>
    <Metadata key="PREVIEW_TIME" value="10:08:32"/>

    <UserConfigurations>
        <ColorConfiguration
            id="theme_color"
            displayName="@string/config_color_theme"
            defaultValue="fremont_green">
            <ColorOption
                id="fremont_green"
                displayName="@string/config_color_fremont_green"
                colors="#0E4D2D #FFC72C #FFF8E7 #186B43" />
            <ColorOption
                id="tactical_slate"
                displayName="@string/config_color_tactical"
                colors="#1C2321 #E6A817 #E0E0E0 #3A4743" />
            <ColorOption
                id="midnight_teal"
                displayName="@string/config_color_midnight"
                colors="#0D2E2B #288B77 #E8F5F2 #175449" />
        </ColorConfiguration>

        <BooleanConfiguration
            id="show_seconds"
            displayName="@string/config_show_seconds"
            defaultValue="true" />
    </UserConfigurations>

    <Scene backgroundColor="#000000">

        <!-- Outer Bezel Accent Ring (Interactive Mode) -->
        <PartDraw x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" alpha="0"/>
            <Variant mode="INTERACTIVE" alpha="255"/>
            <Arc centerX="225" centerY="225" width="426" height="426" startAngle="0" endAngle="360">
                <Stroke color="[CONFIGURATION.theme_color.0]" thickness="3"/>
            </Arc>
            <!-- Gold Cardinal Indicators -->
            <Line startX="225" startY="12" endX="225" endY="24">
                <Stroke color="[CONFIGURATION.theme_color.1]" thickness="3" cap="ROUND"/>
            </Line>
            <Line startX="438" startY="225" endX="426" endY="225">
                <Stroke color="[CONFIGURATION.theme_color.1]" thickness="3" cap="ROUND"/>
            </Line>
            <Line startX="225" startY="438" endX="225" endY="426">
                <Stroke color="[CONFIGURATION.theme_color.1]" thickness="3" cap="ROUND"/>
            </Line>
            <Line startX="12" startY="225" endX="24" endY="225">
                <Stroke color="[CONFIGURATION.theme_color.1]" thickness="3" cap="ROUND"/>
            </Line>
        </PartDraw>

        <!-- Optional Outer Seconds Ring -->
        <PartDraw x="0" y="0" width="450" height="450" alpha="[CONFIGURATION.show_seconds ? 255 : 0]">
            <Variant mode="AMBIENT" alpha="0"/>
            <Arc centerX="225" centerY="225" width="440" height="440" startAngle="0" endAngle="([SECOND] * 6)">
                <Stroke color="[CONFIGURATION.theme_color.1]" thickness="2" cap="ROUND"/>
            </Arc>
        </PartDraw>

        <!-- Fremont Academy School Emblem in Center Upper Sub-dial -->
        <PartImage x="195" y="125" width="60" height="60" resource="@drawable/school_logo">
            <Variant mode="AMBIENT" alpha="60"/>
            <Variant mode="INTERACTIVE" alpha="255"/>
        </PartImage>

        <!-- Center Digital Time Display -->
        <PartText x="100" y="195" width="250" height="64">
            <Text align="CENTER" ellipsis="false">
                <Font family="SYNC_TO_DEVICE" size="58" weight="BOLD" color="#FFFFFF">
                    <Template>%s:%s</Template>
                    <Parameter expression="[HOUR_12_Z]"/>
                    <Parameter expression="[MINUTE_Z]"/>
                </Font>
            </Text>
        </PartText>

        <!-- AM/PM & Seconds Tag -->
        <PartText x="280" y="200" width="65" height="24">
            <Variant mode="AMBIENT" alpha="0"/>
            <Text align="LEFT" ellipsis="false">
                <Font family="SYNC_TO_DEVICE" size="14" weight="BOLD" color="[CONFIGURATION.theme_color.1]">
                    <Template>%s</Template>
                    <Parameter expression="[IS_24_HOUR_MODE ? '' : ([AMPM] == 0 ? 'AM' : 'PM')]"/>
                </Font>
            </Text>
        </PartText>

        <!-- Date & Day of Week -->
        <PartText x="100" y="258" width="250" height="28">
            <Text align="CENTER" ellipsis="false">
                <Font family="SYNC_TO_DEVICE" size="18" weight="MEDIUM" color="[CONFIGURATION.theme_color.1]">
                    <Template>%s, %s %s</Template>
                    <Parameter expression="[DAY_OF_WEEK_SHORT]"/>
                    <Parameter expression="[MONTH_SHORT]"/>
                    <Parameter expression="[DAY]"/>
                </Font>
            </Text>
        </PartText>

        <!-- ================================================================= -->
        <!-- COMPLICATION SLOT 1: School Bell Period & Countdown (Top Center)  -->
        <!-- ================================================================= -->
        <ComplicationSlot
            slotId="1"
            supportedTypes="SHORT_TEXT RANGED_VALUE SMALL_IMAGE MONOCHROMATIC_IMAGE LONG_TEXT"
            x="125"
            y="32"
            width="200"
            height="70"
            displayName="@string/slot_school_schedule">
            <BoundingBox x="0" y="0" width="200" height="70" outlineColor="[CONFIGURATION.theme_color.3]" strokeWidth="1.5" cornerRadius="16" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="8" width="200" height="30">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="22" weight="BOLD" color="#FFFFFF">
                            <Template>%s</Template>
                            <Parameter expression="[COMPLICATION.TEXT]"/>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="0" y="38" width="200" height="22">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="14" weight="NORMAL" color="[CONFIGURATION.theme_color.1]">
                            <Template>%s</Template>
                            <Parameter expression="[COMPLICATION.TITLE]"/>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="RANGED_VALUE">
                <PartRangedValue x="10" y="10" width="180" height="50">
                    <Stroke color="[CONFIGURATION.theme_color.1]" thickness="3"/>
                </PartRangedValue>
                <PartText x="0" y="15" width="200" height="30">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="18" weight="BOLD" color="#FFFFFF">
                            <Template>%s</Template>
                            <Parameter expression="[COMPLICATION.TEXT]"/>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="LONG_TEXT">
                <PartText x="10" y="10" width="180" height="50">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="16" weight="MEDIUM" color="#FFFFFF">
                            <Template>%s</Template>
                            <Parameter expression="[COMPLICATION.TEXT]"/>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- ================================================================= -->
        <!-- COMPLICATION SLOT 2: Heart Rate / Wellness (Top Right)            -->
        <!-- ================================================================= -->
        <ComplicationSlot
            slotId="2"
            supportedTypes="SHORT_TEXT RANGED_VALUE SMALL_IMAGE MONOCHROMATIC_IMAGE"
            x="328"
            y="80"
            width="80"
            height="80"
            displayName="@string/slot_heart_rate">
            <BoundingOval x="0" y="0" width="80" height="80" outlineColor="[CONFIGURATION.theme_color.1]" strokeWidth="1.5" />
            <Complication type="SHORT_TEXT">
                <PartImage x="26" y="10" width="28" height="28" resource="[COMPLICATION.ICON]" />
                <PartText x="0" y="42" width="80" height="26">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="18" weight="BOLD" color="#FFFFFF">
                            <Template>%s</Template>
                            <Parameter expression="[COMPLICATION.TEXT]"/>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="RANGED_VALUE">
                <PartRangedValue x="6" y="6" width="68" height="68">
                    <Stroke color="[CONFIGURATION.theme_color.1]" thickness="3"/>
                </PartRangedValue>
                <PartText x="0" y="26" width="80" height="28">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="18" weight="BOLD" color="#FFFFFF">
                            <Template>%s</Template>
                            <Parameter expression="[COMPLICATION.TEXT]"/>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- ================================================================= -->
        <!-- COMPLICATION SLOT 3: Next Event / Calendar (Center Right)         -->
        <!-- ================================================================= -->
        <ComplicationSlot
            slotId="3"
            supportedTypes="SHORT_TEXT SMALL_IMAGE MONOCHROMATIC_IMAGE"
            x="358"
            y="185"
            width="80"
            height="80"
            displayName="@string/slot_calendar">
            <BoundingOval x="0" y="0" width="80" height="80" outlineColor="[CONFIGURATION.theme_color.3]" strokeWidth="1.5" />
            <Complication type="SHORT_TEXT">
                <PartImage x="26" y="10" width="28" height="28" resource="[COMPLICATION.ICON]" />
                <PartText x="0" y="42" width="80" height="26">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="16" weight="MEDIUM" color="#FFFFFF">
                            <Template>%s</Template>
                            <Parameter expression="[COMPLICATION.TEXT]"/>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- ================================================================= -->
        <!-- COMPLICATION SLOT 4: Watch Battery (Bottom Right)                 -->
        <!-- ================================================================= -->
        <ComplicationSlot
            slotId="4"
            supportedTypes="SHORT_TEXT RANGED_VALUE SMALL_IMAGE MONOCHROMATIC_IMAGE"
            x="328"
            y="290"
            width="80"
            height="80"
            displayName="@string/slot_battery">
            <BoundingOval x="0" y="0" width="80" height="80" outlineColor="[CONFIGURATION.theme_color.1]" strokeWidth="1.5" />
            <Complication type="RANGED_VALUE">
                <PartRangedValue x="6" y="6" width="68" height="68">
                    <Stroke color="[CONFIGURATION.theme_color.1]" thickness="3"/>
                </PartRangedValue>
                <PartText x="0" y="26" width="80" height="28">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="18" weight="BOLD" color="#FFFFFF">
                            <Template>%s</Template>
                            <Parameter expression="[COMPLICATION.TEXT]"/>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="SHORT_TEXT">
                <PartImage x="26" y="10" width="28" height="28" resource="[COMPLICATION.ICON]" />
                <PartText x="0" y="42" width="80" height="26">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="16" weight="BOLD" color="#FFFFFF">
                            <Template>%s</Template>
                            <Parameter expression="[COMPLICATION.TEXT]"/>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- ================================================================= -->
        <!-- COMPLICATION SLOT 5: Steps / Active Minutes (Bottom Left)         -->
        <!-- ================================================================= -->
        <ComplicationSlot
            slotId="5"
            supportedTypes="SHORT_TEXT RANGED_VALUE GOAL_PROGRESS SMALL_IMAGE MONOCHROMATIC_IMAGE"
            x="42"
            y="290"
            width="80"
            height="80"
            displayName="@string/slot_steps">
            <BoundingOval x="0" y="0" width="80" height="80" outlineColor="[CONFIGURATION.theme_color.1]" strokeWidth="1.5" />
            <Complication type="SHORT_TEXT">
                <PartImage x="26" y="10" width="28" height="28" resource="[COMPLICATION.ICON]" />
                <PartText x="0" y="42" width="80" height="26">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="16" weight="BOLD" color="#FFFFFF">
                            <Template>%s</Template>
                            <Parameter expression="[COMPLICATION.TEXT]"/>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="GOAL_PROGRESS">
                <PartRangedValue x="6" y="6" width="68" height="68">
                    <Stroke color="[CONFIGURATION.theme_color.1]" thickness="3"/>
                </PartRangedValue>
                <PartText x="0" y="26" width="80" height="28">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="16" weight="BOLD" color="#FFFFFF">
                            <Template>%s</Template>
                            <Parameter expression="[COMPLICATION.TEXT]"/>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- ================================================================= -->
        <!-- COMPLICATION SLOT 6: Quick Action / Wellness Shortcut (Left)      -->
        <!-- ================================================================= -->
        <ComplicationSlot
            slotId="6"
            supportedTypes="SHORT_TEXT SMALL_IMAGE MONOCHROMATIC_IMAGE"
            x="12"
            y="185"
            width="80"
            height="80"
            displayName="@string/slot_quick_action">
            <BoundingOval x="0" y="0" width="80" height="80" outlineColor="[CONFIGURATION.theme_color.3]" strokeWidth="1.5" />
            <Complication type="SMALL_IMAGE">
                <PartImage x="20" y="20" width="40" height="40" resource="[COMPLICATION.IMAGE]" />
            </Complication>
            <Complication type="SHORT_TEXT">
                <PartImage x="26" y="10" width="28" height="28" resource="[COMPLICATION.ICON]" />
                <PartText x="0" y="42" width="80" height="26">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="15" weight="MEDIUM" color="#FFFFFF">
                            <Template>%s</Template>
                            <Parameter expression="[COMPLICATION.TEXT]"/>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- ================================================================= -->
        <!-- COMPLICATION SLOT 7: Weather / UV Index (Top Left)                -->
        <!-- ================================================================= -->
        <ComplicationSlot
            slotId="7"
            supportedTypes="SHORT_TEXT RANGED_VALUE SMALL_IMAGE MONOCHROMATIC_IMAGE"
            x="42"
            y="80"
            width="80"
            height="80"
            displayName="@string/slot_weather">
            <BoundingOval x="0" y="0" width="80" height="80" outlineColor="[CONFIGURATION.theme_color.1]" strokeWidth="1.5" />
            <Complication type="SHORT_TEXT">
                <PartImage x="26" y="10" width="28" height="28" resource="[COMPLICATION.ICON]" />
                <PartText x="0" y="42" width="80" height="26">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="17" weight="BOLD" color="#FFFFFF">
                            <Template>%s</Template>
                            <Parameter expression="[COMPLICATION.TEXT]"/>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="RANGED_VALUE">
                <PartRangedValue x="6" y="6" width="68" height="68">
                    <Stroke color="[CONFIGURATION.theme_color.1]" thickness="3"/>
                </PartRangedValue>
                <PartText x="0" y="26" width="80" height="28">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="17" weight="BOLD" color="#FFFFFF">
                            <Template>%s</Template>
                            <Parameter expression="[COMPLICATION.TEXT]"/>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- ================================================================= -->
        <!-- COMPLICATION SLOT 8: Sub-Dial / Notification Dot (Bottom Center)  -->
        <!-- ================================================================= -->
        <ComplicationSlot
            slotId="8"
            supportedTypes="SHORT_TEXT SMALL_IMAGE MONOCHROMATIC_IMAGE"
            x="185"
            y="350"
            width="80"
            height="80"
            displayName="@string/slot_subdial_notification">
            <BoundingOval x="0" y="0" width="80" height="80" outlineColor="[CONFIGURATION.theme_color.3]" strokeWidth="1.5" />
            <Complication type="SHORT_TEXT">
                <PartImage x="26" y="10" width="28" height="28" resource="[COMPLICATION.ICON]" />
                <PartText x="0" y="42" width="80" height="26">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="16" weight="BOLD" color="#FFFFFF">
                            <Template>%s</Template>
                            <Parameter expression="[COMPLICATION.TEXT]"/>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <PartImage x="20" y="20" width="40" height="40" resource="[COMPLICATION.IMAGE]" />
            </Complication>
        </ComplicationSlot>

    </Scene>
</WatchFace>

